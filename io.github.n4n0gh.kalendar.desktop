[Desktop Entry]
Type=Application
Name=Kalendar
GenericName=Calendar
Comment=A simple calendar that works with online accounts
Exec=kalendar %F
Icon=io.github.n4n0gh.kalendar
Terminal=false
MimeType=text/calendar;
Categories=Qt;KDE;Office;Calendar;
Keywords=calendar;event;appointment;schedule;CalDAV;Google;Nextcloud;iCloud;
